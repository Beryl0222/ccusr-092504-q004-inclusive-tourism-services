{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "普惠旅游公共服务账本领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "SERVICE_COMMITTED",
        "CAPACITY_REPORTED",
        "BENEFIT_GRANTED",
        "OUTAGE_DECLARED",
        "PERFORMANCE_FROZEN"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "service_policy",
        "public_facility",
        "benefit_entitlement",
        "performance_period"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
