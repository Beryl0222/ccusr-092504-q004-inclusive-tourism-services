{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "普惠旅游公共服务账本领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "POLICY_VERSIONED",
        "SERVICE_COMMITTED",
        "FACILITY_REGISTERED",
        "CAPACITY_REPORTED",
        "BOOKING_RECORDED",
        "CONTRACT_SIGNED",
        "EVIDENCE_SUBMITTED",
        "BENEFIT_GRANTED",
        "BENEFIT_REDEEMED",
        "OUTAGE_DECLARED",
        "ALTERNATIVE_ARRANGED",
        "OUTAGE_RESOLVED",
        "TRANSPORT_LINKED",
        "USAGE_AGGREGATED",
        "FEEDBACK_COLLECTED",
        "FUNDS_ALLOCATED",
        "SUBSIDY_PAID",
        "PERFORMANCE_FROZEN",
        "DECISION_MADE"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "service_policy",
        "public_facility",
        "operation_contract",
        "benefit_entitlement",
        "outage_record",
        "transport_link",
        "usage_observation",
        "feedback_record",
        "fund_account",
        "performance_period"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "details": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
